DATABASE_URL=""
DIRECT_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Brevo transactional email (get the API key from Brevo SMTP & API settings)
BREVO_API_KEY=""
# Must be a sender address verified in your Brevo account
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="OneAuth"

# Public base URL of this OneAuth deployment, with no trailing slash
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Cloudinary profile-picture storage. Keep the API secret server-side; never prefix it with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# OAuth/OIDC issuer URL. Production must use the canonical HTTPS origin.
ONEAUTH_ISSUER_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# OpenSSL: OIDC RS256 signing key
# Run these commands from the auth/ directory. Keep the private key secret and
# out of Git. The app expects an unencrypted PKCS#8 RSA private key, at least
# 2048 bits (3072 bits recommended). The public key is derived from the private
# key and published automatically by the JWKS endpoint; do not put it in .env.
#
# 1) Create a local directory and generate the private key:
#    mkdir -p .secrets
#    chmod 700 .secrets
#    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 \
#      -out .secrets/oneauth-oidc-private.pem
#    chmod 600 .secrets/oneauth-oidc-private.pem
#
# 2) (Optional) Export the public key for backup/inspection:
#    openssl pkey -in .secrets/oneauth-oidc-private.pem -pubout \
#      -out .secrets/oneauth-oidc-public.pem
#
# 3) Validate the key and inspect its size:
#    openssl pkey -in .secrets/oneauth-oidc-private.pem -check -noout
#    openssl pkey -in .secrets/oneauth-oidc-private.pem -text -noout
#
# 4) Copy the private PEM into ONEAUTH_OIDC_PRIVATE_KEY as a SINGLE LINE,
#    replacing each real newline with the two characters backslash+n (\\n).
#    This command prints the escaped value; copy its output between the quotes:
#    awk 'BEGIN { ORS="" } { if (NR > 1) printf "\\\\n"; printf "%s", $0 }' \
#      .secrets/oneauth-oidc-private.pem
#
# 5) Generate a stable key ID (run once per key; don't regenerate on every start):
#    openssl rand -hex 8
#    Put the result in ONEAUTH_OIDC_KEY_ID. During rotation, publish/activate the
#    new key deliberately and account for existing tokens before retiring the old key.
#
# Example only — do not paste these placeholders literally:
ONEAUTH_OIDC_PRIVATE_KEY=""
ONEAUTH_OIDC_KEY_ID=""

# Comma-separated exact browser origins allowed to call the MCP endpoint. Empty means no browser origins.
MCP_ALLOWED_ORIGINS=""

# 32-byte key used to encrypt TOTP authenticator secrets at rest.
# Generate with: openssl rand -hex 32
# Keep the same value across restarts and backups; changing it can make stored
# encrypted TOTP secrets unreadable.
ONEAUTH_ENCRYPTION_KEY=""

# Comma-separated email addresses allowed to access the OneAuth admin console.
ONEAUTH_ADMIN_EMAILS=""

# Server-side Cloudflare tunnel provisioning for VortiqLabs Agent. Never expose these to clients.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_TUNNEL_DOMAIN="nishantapps.in"
# Long random secret for the daily tunnel cleanup job (e.g. openssl rand -hex 32).
ONEAUTH_CRON_SECRET=""
